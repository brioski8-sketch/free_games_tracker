# ============================================================================
# Credentials for weekly_report.py
# ============================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values, OR
# export these as environment variables. Environment variables always win.
# The AgentMail key is ALSO resolved automatically from ~/.hermes/config.yaml
# (mcp_servers.agentmail.env.AGENTMAIL_API_KEY, or a top-level env: block) and
# from ~/.hermes/.env, so on this host you usually need nothing here.
#
# NEVER commit your real .env. These are secrets.
# ============================================================================

# --- HTML email delivery (primary mode: `--email`) -------------------------
# AgentMail API key. Also read from ~/.hermes/config.yaml / ~/.hermes/.env.
AGENTMAIL_API_KEY=YOUR_AGENTMAIL_KEY_HERE

# --- Telegram delivery (optional legacy mode) ------------------------------
# Bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Target chat / channel id (e.g. 123456789, or @channelusername for public channels)
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE
