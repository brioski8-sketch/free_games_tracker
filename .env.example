# ============================================================================
# Telegram bot credentials for weekly_report.py
# ============================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values, OR
# export these as environment variables. Environment variables always win over
# values in the .env file.
#
#   cp .env.example .env
#   # then edit .env with your real token + chat id
#
# NEVER commit your real .env. The bot token is a secret — anyone with it can
# post 20 messages/min to your bot.
# ============================================================================

# Bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Target chat / channel id (e.g. 123456789, or @channelusername for public channels)
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE
